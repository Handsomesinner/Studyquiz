# Never commit real values. Load these into your environment; no .env auto-loader is used.
ANTHROPIC_API_KEY=
STUDYQUIZ_ACCESS_PIN=
# Required on Vercel. Local development defaults to a persistent SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Use a PRIVATE Vercel Blob store. Public uploads are refused.
BLOB_READ_WRITE_TOKEN=
BLOB_ACCESS=private
MAX_UPLOAD_MB=100
MAX_DOCUMENT_PAGES=200
MAX_EXTRACTED_CHARS=5000000
AI_DAILY_GLOBAL_CALLS=100
AI_DAILY_WORKSPACE_CALLS=30
